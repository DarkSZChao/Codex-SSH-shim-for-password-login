# Copy this file to .env and edit it for your own SSH setup.
# Absolute path to the real OpenSSH client, never to the shim built here.
REAL_SSH=C:\Windows\System32\OpenSSH\ssh.exe
# Use the alias name from your local OpenSSH config.
TARGET_HOST=codex-remote
# Password is read directly at runtime; use quotes to preserve surrounding spaces.
PASSWORD="YOUR_SSH_PASSWORD"
